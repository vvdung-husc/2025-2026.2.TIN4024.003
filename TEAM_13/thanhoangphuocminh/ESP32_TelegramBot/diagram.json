{
  "version": 1,
  "author": "Minh Thân Hoàng Phước",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": { "builder": "esp-idf" }
    },
    { "type": "wokwi-pir-motion-sensor", "id": "pir1", "top": -140, "left": -120, "attrs": {} },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": -100,
      "left": 150,
      "attrs": { "color": "red" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "pir1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "pir1:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "pir1:OUT", "esp:27", "green", [ "v0" ] ],
    [ "esp:GND.2", "led1:C", "black", [ "v0" ] ],
    [ "esp:23", "led1:A", "red", [ "v0" ] ]
  ],
  "dependencies": {}
}